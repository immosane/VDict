<Window
    x:Class="VDict.WinUI.Diagnostics.DebugTimelineWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
      x:Name="Root"
      Padding="12"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="8">
        <Ellipse
            x:Name="LiveIndicator"
            Width="8"
            Height="8"
            Fill="{ThemeResource SystemFillColorSuccessBrush}" />
        <TextBlock
            x:Name="StateText"
            x:Uid="DebugTimeline_State"
            VerticalAlignment="Center"
            FontWeight="SemiBold" />
        <TextBlock
            x:Uid="DebugTimeline_Limit"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Button
          x:Name="PauseButton"
          x:Uid="DebugTimeline_Pause"
          Grid.Column="1"
          Click="PauseButton_Click" />
      <Button
          x:Uid="DebugTimeline_Clear"
          Grid.Column="2"
          Click="ClearButton_Click" />
      <Button
          x:Uid="DebugTimeline_Copy"
          Grid.Column="3"
          Click="CopyButton_Click" />
    </Grid>

    <Grid
        Grid.Row="1"
        Margin="0,10,0,4"
        Padding="6,0"
        ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="82" />
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="112" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Uid="DebugTimeline_Time" FontWeight="SemiBold" />
      <TextBlock x:Uid="DebugTimeline_Elapsed" Grid.Column="1" FontWeight="SemiBold" />
      <TextBlock x:Uid="DebugTimeline_Interval" Grid.Column="2" FontWeight="SemiBold" />
      <TextBlock x:Uid="DebugTimeline_Correlation" Grid.Column="3" FontWeight="SemiBold" />
      <TextBlock x:Uid="DebugTimeline_Event" Grid.Column="4" FontWeight="SemiBold" />
      <TextBlock x:Uid="DebugTimeline_Detail" Grid.Column="5" FontWeight="SemiBold" />
    </Grid>

    <ListView
        x:Name="TimelineList"
        Grid.Row="2"
        IsItemClickEnabled="False"
        ItemsSource="{x:Bind Rows}">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="MinHeight" Value="26" />
          <Setter Property="Padding" Value="6,2" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="82" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="112" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding TimeText}" />
            <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="12" Text="{Binding ElapsedText}" />
            <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="12" Text="{Binding IntervalText}" />
            <TextBlock Grid.Column="3" FontFamily="Consolas" FontSize="12" Text="{Binding CorrelationText}" />
            <TextBlock Grid.Column="4" FontFamily="Consolas" FontSize="12" Text="{Binding Stage}" />
            <TextBlock
                Grid.Column="5"
                FontFamily="Consolas"
                FontSize="12"
                Text="{Binding Detail}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{Binding Detail}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock
        x:Uid="DebugTimeline_Footer"
        Grid.Row="3"
        Margin="0,6,0,0"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        FontSize="11" />
  </Grid>
</Window>
