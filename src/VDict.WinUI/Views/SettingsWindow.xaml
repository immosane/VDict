<Window
    x:Class="VDict.WinUI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
      x:Name="Root"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <NavigationView
        x:Name="SettingsNavigation"
        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        CompactPaneLength="48"
        OpenPaneLength="220"
        PaneDisplayMode="Auto"
        SelectionChanged="SettingsNavigation_SelectionChanged">
      <NavigationView.PaneHeader>
        <StackPanel
            Margin="4,0,0,8"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
          <Image
              Width="28"
              Height="28"
              Source="ms-appx:///Assets/logo_round.png"
              Stretch="Uniform" />
          <TextBlock
              x:Name="SettingsPaneTitle"
              x:Uid="SettingsWindow_PaneTitle"
              VerticalAlignment="Center"
              FontSize="16"
              FontWeight="SemiBold" />
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Uid="SettingsWindow_DictionariesItem" Tag="dictionaries">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="SettingsWindow_ReadingItem" Tag="reading">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="SettingsWindow_SecurityItem" Tag="security">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="SettingsWindow_DataItem" Tag="data">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Uid="SettingsWindow_AboutItem" Tag="about">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <ScrollViewer
          x:Name="SettingsScrollViewer"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <ContentControl
            x:Name="SettingsSectionHost"
            MaxWidth="1120"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Padding="{StaticResource VDictPagePaddingThickness}" />
      </ScrollViewer>
    </NavigationView>

    <Grid
        x:Name="SettingsFooter"
        Grid.Row="1"
        MinHeight="72"
        Padding="20,10"
        BorderThickness="0,1,0,0"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer
          MaxHeight="144"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <InfoBar
            x:Name="SaveError"
            HorizontalAlignment="Stretch"
            IsClosable="True"
            Severity="Error" />
      </ScrollViewer>
      <StackPanel
          x:Name="FooterActions"
          Grid.Row="1"
          Margin="0,8,0,0"
          HorizontalAlignment="Right"
          Orientation="Horizontal"
          Spacing="8">
        <StackPanel
            x:Name="OperationProgressPanel"
            Width="260"
            Visibility="Collapsed">
          <TextBlock
              x:Name="OperationProgressText"
              MaxLines="1"
              TextTrimming="CharacterEllipsis" />
          <ProgressBar
              x:Name="OperationProgressBar"
              Minimum="0"
              Maximum="1"
              Value="0" />
        </StackPanel>
        <ProgressRing
            x:Name="SavingProgress"
            Width="24"
            Height="24"
            IsActive="False" />
        <Button
            x:Name="CancelOperationButton"
            x:Uid="SettingsWindow_CancelOperationButton"
            AccessKey="O"
            IsEnabled="{x:Bind ViewModel.CanCancelOperation, Mode=OneWay}"
            Click="CancelOperation_Click"
            Visibility="Collapsed" />
        <Button
            x:Uid="SettingsWindow_CancelButton"
            AccessKey="C"
            Click="Cancel_Click"
            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
        <Button
            x:Name="SaveButton"
            x:Uid="SettingsWindow_SaveButton"
            AccessKey="S"
            Click="Save_Click"
            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
