<UserControl
    x:Class="VDict.WinUI.Views.SettingsSections.SecurityCompatibilitySettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <TextBlock x:Uid="Security_Title" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock
        x:Uid="Security_Description"
        TextWrapping="Wrap" />
    <ComboBox
        x:Name="ExternalLinkSelectorControl"
        x:Uid="Security_ExternalLinks"
        Style="{StaticResource VDictSettingsComboBoxStyle}">
      <ComboBoxItem x:Uid="Security_ExternalLinksBlock" Tag="block" />
      <ComboBoxItem x:Uid="Security_ExternalLinksSystemBrowser" Tag="system-browser" />
    </ComboBox>
  </StackPanel>
</UserControl>
