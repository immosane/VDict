<UserControl
    x:Class="VDict.WinUI.Views.SettingsSections.AboutSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12">
    <TextBlock x:Uid="About_Title" Style="{ThemeResource TitleTextBlockStyle}" />
    <StackPanel
        Margin="0,8,0,4"
        Orientation="Horizontal"
        Spacing="12">
      <Image
          Width="48"
          Height="48"
          Source="ms-appx:///Assets/logo_round.png"
          Stretch="Uniform" />
      <TextBlock
          VerticalAlignment="Center"
          FontSize="20"
          FontWeight="SemiBold"
          Text="VDict" />
    </StackPanel>
    <TextBlock
        x:Uid="About_Technologies"
        TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
