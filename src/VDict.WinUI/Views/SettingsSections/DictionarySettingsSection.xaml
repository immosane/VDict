<UserControl
    x:Class="VDict.WinUI.Views.SettingsSections.DictionarySettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="DictionaryPanelHeadingStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DictionaryGroupHeadingStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DictionaryListItemStyle" TargetType="ListViewItem">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Resources>

  <StackPanel Spacing="16">
    <StackPanel Spacing="6">
      <TextBlock x:Uid="Dictionaries_Title" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock
          x:Uid="Dictionaries_Description"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
          x:Name="AddDictionaryButton"
          x:Uid="Dictionaries_AddButton"
          Style="{StaticResource AccentButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon FontSize="14" Glyph="&#xE710;" />
          <TextBlock
              x:Uid="Dictionaries_AddButtonText"
              VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <CommandBar
          Grid.Column="1"
          HorizontalAlignment="Right"
          Background="Transparent"
          DefaultLabelPosition="Collapsed"
          IsDynamicOverflowEnabled="False"
          IsOpen="False">
        <AppBarButton x:Name="MoveDictionaryUpButton" x:Uid="Dictionaries_MoveUpButton">
          <AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="MoveDictionaryDownButton" x:Uid="Dictionaries_MoveDownButton">
          <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
        </AppBarButton>
        <CommandBar.SecondaryCommands>
          <AppBarButton x:Name="RemoveDictionaryButton" x:Uid="Dictionaries_RemoveButton" Icon="Delete" />
        </CommandBar.SecondaryCommands>
      </CommandBar>
    </Grid>

    <Grid x:Name="DictionaryLayoutControl" ColumnSpacing="16" RowSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="DictionaryListColumnControl" Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border
          x:Name="DictionaryLibraryPanelControl"
          x:Uid="Dictionaries_LibraryPanel"
          MinHeight="390"
          VerticalAlignment="Top"
          Background="{ThemeResource LayerFillColorAltBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource VDictSurfaceCornerRadius}">
        <Grid Padding="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="4,0,4,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="Dictionaries_LibraryHeading"
                Style="{StaticResource DictionaryPanelHeadingStyle}" />
            <TextBlock
                x:Name="DictionaryCountTextControl"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>

          <Grid Grid.Row="1">
            <ListView
                x:Name="DictionaryListControl"
                x:Uid="Dictionaries_List"
                AllowDrop="True"
                Background="Transparent"
                ItemContainerStyle="{StaticResource DictionaryListItemStyle}"
                ItemContainerTransitions="{x:Null}"
                MinHeight="300">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                      MaxLines="2"
                      Text="{Binding EffectiveDisplayName}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="Wrap"
                      ToolTipService.ToolTip="{Binding EffectiveDisplayName}" />
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="DictionaryEmptyStateControl"
                x:Uid="Dictionaries_EmptyState"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
          </Grid>

          <TextBlock
              x:Uid="Dictionaries_DropHint"
              Grid.Row="2"
              Margin="4,10,4,2"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              FontSize="12"
              TextWrapping="Wrap" />
        </Grid>
      </Border>

      <Border
          x:Name="DictionaryEditorPanelControl"
          x:Uid="Dictionaries_EditorPanel"
          Grid.Column="1"
          MinWidth="280"
          VerticalAlignment="Top"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource VDictSurfaceCornerRadius}">
        <Grid Padding="20">
          <TextBlock
              x:Name="DictionaryEditorEmptyStateControl"
              x:Uid="Dictionaries_EditorEmptyState"
              MinHeight="180"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              IsHitTestVisible="False"
              TextAlignment="Center"
              TextWrapping="Wrap" />

          <StackPanel
              x:Name="DictionaryEditorControl"
              Spacing="14"
              Visibility="Collapsed">
            <StackPanel Spacing="2">
              <TextBlock
                  x:Uid="Dictionaries_SelectedHeading"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  FontSize="12" />
              <TextBlock
                  x:Name="SelectedDictionaryNameTextControl"
                  FontSize="22"
                  FontWeight="SemiBold"
                  MaxLines="2"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="12,9"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
              <Grid ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE946;" />
                <TextBlock
                    x:Name="DictionaryIndexStatusTextControl"
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
              </Grid>
            </Border>

            <TextBlock
                x:Uid="Dictionaries_BasicHeading"
                Style="{StaticResource DictionaryGroupHeadingStyle}" />
            <TextBox
                x:Name="DictionaryDisplayNameBoxControl"
                x:Uid="Dictionaries_DisplayName" />
            <TextBox
                x:Name="DictionaryMdxPathBoxControl"
                x:Uid="Dictionaries_MdxPath"
                IsReadOnly="True" />

            <TextBlock
                x:Uid="Dictionaries_AccessHeading"
                Style="{StaticResource DictionaryGroupHeadingStyle}" />
            <StackPanel Spacing="8">
              <ToggleSwitch x:Name="DictionaryEnabledToggleControl" x:Uid="Dictionaries_EnabledToggle" />
              <ToggleSwitch
                  x:Name="DictionaryBlockNetworkToggleControl"
                  x:Uid="Dictionaries_BlockNetworkToggle" />
            </StackPanel>

            <Expander
                x:Name="DictionaryAdvancedOptions"
                x:Uid="Dictionaries_AdvancedOptions">
              <StackPanel Padding="0,10,0,4" Spacing="12">
                <TextBlock
                    x:Uid="Dictionaries_ResourcesHeading"
                    Style="{StaticResource DictionaryGroupHeadingStyle}" />
                <TextBox
                    x:Name="DictionaryMddPathsBoxControl"
                    x:Uid="Dictionaries_MddPaths"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    MaxHeight="90"
                    TextWrapping="NoWrap" />
                <TextBox
                    x:Name="DictionaryCssPathsBoxControl"
                    x:Uid="Dictionaries_CssPaths"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    MaxHeight="90"
                    TextWrapping="NoWrap" />
                <TextBox
                    x:Name="DictionaryScriptPathsBoxControl"
                    x:Uid="Dictionaries_ScriptPaths"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    MaxHeight="90"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="DictionaryAutoScriptPathsTextControl"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <Border
                    Height="1"
                    Margin="0,4"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    x:Uid="Dictionaries_AppearanceHeading"
                    Style="{StaticResource DictionaryGroupHeadingStyle}" />
                <ToggleSwitch
                    x:Name="DictionaryOverrideFontToggleControl"
                    x:Uid="Dictionaries_OverrideFont" />
                <ToggleSwitch
                    x:Name="DictionaryOverrideTypographyToggleControl"
                    x:Uid="Dictionaries_OverrideTypography" />
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <NumberBox
                      x:Name="DictionaryFontSizeBoxControl"
                      x:Uid="Dictionaries_FontSize"
                      Minimum="10"
                      Maximum="48" />
                  <NumberBox
                      x:Name="DictionaryLineHeightBoxControl"
                      x:Uid="Dictionaries_LineHeight"
                      Grid.Column="1"
                      Minimum="1"
                      Maximum="3"
                      SmallChange="0.05" />
                </Grid>
                <TextBox x:Name="DictionaryLatinFontBoxControl" x:Uid="Dictionaries_LatinFont" />
                <TextBox x:Name="DictionaryCjkFontBoxControl" x:Uid="Dictionaries_CjkFont" />
                <ComboBox
                    x:Name="DictionaryDarkModeSelectorControl"
                    x:Uid="Dictionaries_DarkModeSelector"
                    Style="{StaticResource VDictSettingsComboBoxStyle}">
                  <ComboBoxItem x:Uid="Dictionaries_DarkModeGlobal" Tag="global" />
                  <ComboBoxItem x:Uid="Dictionaries_DarkModeOriginal" Tag="original" />
                  <ComboBoxItem x:Uid="Dictionaries_DarkModeDark" Tag="dark" />
                </ComboBox>
                <Button
                    x:Name="RestoreDictionaryAppearanceButton"
                    x:Uid="Dictionaries_RestoreAppearance"
                    HorizontalAlignment="Left" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
