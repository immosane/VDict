<UserControl
    x:Class="VDict.WinUI.Views.SettingsSections.DataMaintenanceSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <TextBlock x:Uid="Data_Title" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock x:Uid="Data_SettingsHeading" FontSize="18" FontWeight="SemiBold" />
    <StackPanel Spacing="10">
      <Button x:Name="ImportSettingsButton" x:Uid="Data_ImportSettings" HorizontalAlignment="Left" />
      <Button x:Name="ExportSettingsButton" x:Uid="Data_ExportSettings" HorizontalAlignment="Left" />
      <Button x:Name="OpenDataFolderButton" x:Uid="Data_OpenDataFolder" HorizontalAlignment="Left" />
      <Button x:Name="OpenLogsFolderButton" x:Uid="Data_OpenLogsFolder" HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock
        x:Uid="Data_CacheHeading"
        Margin="0,8,0,0"
        FontSize="18"
        FontWeight="SemiBold" />
    <Button x:Name="InspectCacheButton" x:Uid="Data_InspectCache" HorizontalAlignment="Left" />
    <TextBlock
        x:Name="CacheUsageTextControl"
        x:Uid="Data_CacheNotInspected"
        FontFamily="Consolas"
        TextWrapping="Wrap" />

    <Expander
        x:Uid="Data_DangerousOperations">
      <StackPanel Padding="0,8,0,4" Spacing="10">
        <TextBlock
            x:Uid="Data_DangerousOperationsWarning"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            TextWrapping="Wrap" />
        <Button
            x:Name="ClearTemporaryCacheButton"
            x:Uid="Data_ClearTemporaryCache"
            HorizontalAlignment="Left" />
        <Button
            x:Name="ClearBrowserDataButton"
            x:Uid="Data_ClearBrowserCache"
            HorizontalAlignment="Left" />
        <Button
            x:Name="RebuildIndexesButton"
            x:Uid="Data_RebuildIndexes"
            HorizontalAlignment="Left" />
        <Button
            x:Name="RestoreAllDefaultsButton"
            x:Uid="Data_RestoreDefaults"
            HorizontalAlignment="Left" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
