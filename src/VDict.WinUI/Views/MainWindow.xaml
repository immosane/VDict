<Window
    x:Class="VDict.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VDict.WinUI.Controls"
    Title="VDict">
  <Grid
      x:Name="Root"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.Resources>
      <Style x:Key="ZoomButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="86" />
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="AppTitleBar"
        x:Uid="MainWindow_AppTitleBar"
        Padding="16,0,8,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="CaptionButtonInsetColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="10">
        <Image
            Width="18"
            Height="18"
            Source="ms-appx:///Assets/logo_round.png"
            Stretch="Uniform" />
        <Image
            Width="65"
            Height="16"
            Source="ms-appx:///Assets/logo_rect.png"
            Stretch="Uniform" />
        <TextBlock
            x:Name="ProductTitle"
            VerticalAlignment="Center"
            FontSize="16"
            FontWeight="SemiBold"
            Text="VDict"
            Visibility="Collapsed" />
      </StackPanel>
    </Grid>

    <Border
        x:Name="SearchToolbar"
        x:Uid="MainWindow_SearchToolbar"
        Grid.Row="1"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
      <Grid Margin="16,8,16,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="76" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
          <Button
              x:Name="BackButton"
              x:Uid="MainWindow_BackButton"
              Width="36"
              Height="36"
              Command="{x:Bind ViewModel.Reader.BackCommand}"
              HorizontalContentAlignment="Center"
              Padding="0"
              VerticalContentAlignment="Center">
            <SymbolIcon Symbol="Back" />
          </Button>
          <Button
              x:Name="ForwardButton"
              x:Uid="MainWindow_ForwardButton"
              Width="36"
              Height="36"
              Command="{x:Bind ViewModel.Reader.ForwardCommand}"
              HorizontalContentAlignment="Center"
              Padding="0"
              VerticalContentAlignment="Center">
            <SymbolIcon Symbol="Forward" />
          </Button>
        </StackPanel>

        <Grid
            Grid.Column="1"
            Margin="8,0"
            ColumnSpacing="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
              x:Name="SearchBox"
              x:Uid="MainWindow_SearchBox"
              Height="38"
              VerticalAlignment="Center"
              VerticalContentAlignment="Center"
              Text="{x:Bind ViewModel.Reader.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button
              x:Uid="MainWindow_SearchButton"
              Grid.Column="1"
              Width="38"
              Height="38"
              Click="SearchButton_Click"
              HorizontalContentAlignment="Center"
              Padding="0"
              VerticalContentAlignment="Center">
            <SymbolIcon Symbol="Find" />
          </Button>
        </Grid>

        <Button
            x:Uid="MainWindow_SettingsButton"
            Grid.Column="2"
            MinWidth="70"
            Height="36"
            Command="{x:Bind ViewModel.OpenSettingsCommand}" />

        <ScrollViewer
            x:Name="LookupPathScroller"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Height="30"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
          <StackPanel
              x:Name="LookupPathPanel"
              VerticalAlignment="Center"
              Orientation="Horizontal" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid
        x:Name="ContentLayoutGrid"
        Grid.Row="2"
        Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
            x:Name="CandidateColumn"
            Width="280"
            MinWidth="0" />
        <ColumnDefinition x:Name="CandidateDividerColumn" Width="8" />
        <ColumnDefinition
            x:Name="ReaderColumn"
            Width="*"
            MinWidth="480" />
      </Grid.ColumnDefinitions>

      <Border
          x:Name="CandidatePane"
          x:Uid="MainWindow_CandidatePane"
          Grid.Column="0"
          Padding="10"
          Background="Transparent">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
              x:Uid="MainWindow_DictionariesHeading"
              Margin="4,0,4,8"
              FontSize="14"
              FontWeight="SemiBold" />
          <ListView
              x:Name="DictionarySelector"
              x:Uid="MainWindow_DictionarySelector"
              Grid.Row="1"
              DisplayMemberPath="Name"
              IsEnabled="{x:Bind ViewModel.Reader.CanSelectDictionary, Mode=OneWay}"
              SelectionChanged="DictionarySelector_SelectionChanged" />
          <TextBlock
              x:Uid="MainWindow_CandidatesHeading"
              Grid.Row="2"
              Margin="4,12,4,4"
              FontSize="14"
              FontWeight="SemiBold" />
          <TextBlock
              Grid.Row="3"
              Margin="4,0,4,6"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              MaxLines="2"
              Text="{x:Bind ViewModel.Reader.CandidateStateMessage, Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
          <ListView
              x:Name="CandidateList"
              x:Uid="MainWindow_CandidateList"
              Grid.Row="4"
              ItemContainerTransitions="{x:Null}"
              IsItemClickEnabled="True"
              ItemClick="CandidateList_ItemClick"
              ItemsSource="{x:Bind ViewModel.Reader.Candidates}" />
        </Grid>
      </Border>

      <controls:PaneResizeDivider
          x:Name="CandidateDivider"
          x:Uid="MainWindow_CandidateDivider"
          Grid.Column="1"
          IsTabStop="True"
          KeyDown="CandidateDivider_KeyDown"
          PointerCaptureLost="CandidateDivider_PointerCaptureLost"
          PointerMoved="CandidateDivider_PointerMoved"
          PointerPressed="CandidateDivider_PointerPressed"
          PointerReleased="CandidateDivider_PointerReleased" />

      <Border
          x:Name="ReaderCard"
          x:Uid="MainWindow_ReaderCard"
          Grid.Column="2"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="10">
        <ContentControl
            x:Name="ReaderHostContainer"
            Margin="10"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
      </Border>
    </Grid>

    <Border
        x:Name="StatusBar"
        x:Uid="MainWindow_StatusBar"
        Grid.Row="3"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
      <Grid Margin="14,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            MaxLines="1"
            Text="{x:Bind ViewModel.Reader.StatusMessage, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="2">
          <Button
              x:Name="ZoomOutButton"
              x:Uid="MainWindow_ZoomOutButton"
              Click="ZoomOut_Click"
              Style="{StaticResource ZoomButtonStyle}">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                FontSize="12"
                Glyph="&#xE738;" />
          </Button>
          <TextBlock
              x:Name="ZoomPercentText"
              Width="48"
              VerticalAlignment="Center"
              FontSize="12"
              FontWeight="SemiBold"
              Text="{x:Bind ViewModel.Reader.ZoomPercent, Mode=OneWay}"
              TextAlignment="Center" />
          <Button
              x:Name="ZoomInButton"
              x:Uid="MainWindow_ZoomInButton"
              Click="ZoomIn_Click"
              Style="{StaticResource ZoomButtonStyle}">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                FontSize="12"
                Glyph="&#xE710;" />
          </Button>
          <Button
              x:Name="ZoomResetButton"
              x:Uid="MainWindow_ZoomResetButton"
              Click="ZoomReset_Click"
              Style="{StaticResource ZoomButtonStyle}">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                FontSize="12"
                Glyph="&#xE72C;" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
