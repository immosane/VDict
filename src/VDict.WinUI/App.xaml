<Application
    x:Class="VDict.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <x:Double x:Key="VDictPagePadding">24</x:Double>
      <x:Double x:Key="VDictControlSpacing">8</x:Double>
      <x:Double x:Key="VDictSectionSpacing">20</x:Double>
      <x:Double x:Key="VDictTitleBarHeight">52</x:Double>
      <x:Double x:Key="VDictToolbarControlHeight">36</x:Double>
      <x:Double x:Key="VDictIconButtonSize">36</x:Double>
      <x:Double x:Key="VDictCandidateMinWidth">180</x:Double>
      <x:Double x:Key="VDictCandidatePreferredWidth">260</x:Double>
      <x:Double x:Key="VDictCandidateMaxWidth">380</x:Double>
      <x:Double x:Key="VDictStatusBarHeight">44</x:Double>
      <Thickness x:Key="VDictPagePaddingThickness">24</Thickness>
      <Thickness x:Key="VDictCompactPagePaddingThickness">16</Thickness>
      <CornerRadius x:Key="VDictSurfaceCornerRadius">8</CornerRadius>
      <Style x:Key="VDictSettingsComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
